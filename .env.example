# ==============================================================================
# MacOS AI Agent - Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file or real API keys to GitHub!
# ==============================================================================

# Required: Google Gemini API Key (Get yours at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Preferred Gemini Model (defaults to gemini-3.5-flash-lite for speed and high rate-limits)
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Automated Gmail Delivery via SMTP
# To enable the agent to transmit emails directly in the background:
# 1. Generate a 16-character App Password at https://myaccount.google.com/apppasswords
# 2. Enter your email address and app password below:
SENDER_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password_here
